   "source": [
    "Calculate Click Through Rate (CTR)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "3d761c89-1f63-4e43-a496-49c53be88e85",
   "metadata": {},
   "source": [
    "ctr_df = (\n",
    "    ads_actions.groupby(\"ad_name\", as_index=False)\n",
    "    .agg(\n",
    "        clicked_count=(\"clicked_ad\", lambda x: x.eq(1).sum()),\n",
    "        ads_count=(\"clicked_ad\", \"count\"),\n",
    "    )\n",
    ")\n",
    "\n",
    "ctr_df[\"ad_ctr\"] = (\n",
    "    100 * ctr_df[\"clicked_count\"]\n",
    "    / ctr_df[\"ads_count\"].replace(0, float(\"nan\"))\n",
    ")\n",
    "\n",
    "ctr_df = ctr_df[[\"ad_name\", \"ad_ctr\"]]\n",
    "ctr_df"
   ]
  },
  {
